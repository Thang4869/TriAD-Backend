NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/triad?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-refresh-secret
JWT_PREAUTH_SECRET=replace-with-at-least-32-characters-preauth-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
TOTP_ISSUER=TriAD
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

FRONTEND_URL=http://localhost:3000

# Optional cookie domain.
# Leave unset when frontend/backend use unrelated domains
# such as *.vercel.app and *.onrender.com.
# COOKIE_DOMAIN=

CORS_ORIGIN=http://localhost:3000

# Proxy trust: 0 = do not trust X-Forwarded-For. Set only when behind a
# known reverse proxy (e.g. 1 for a single controlled proxy hop).
# For multiple proxies, prefer explicit IPv4 CIDRs / trusted IPs.
# Do not configure true, 0.0.0.0/0, IPv6 CIDRs or IPv4-mapped IPv6 CIDRs.
TRUST_PROXY=0