{
  "name": "triad-backend",
  "version": "1.0.0",
  "description": "TriAD E-Commerce Backend API",
  "main": "dist/server.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs -- src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.workspace.mts",
    "build": "tsc -p tsconfig.build.json && tsc-alias",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "dev": "cross-env TS_NODE_BASEURL=./ kill-port 5000 && cross-env TS_NODE_BASEURL=./ TS_NODE_FILES=true nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "kill-port": "kill-port 5000",
    "test:coverage": "vitest run --config vitest.workspace.mts --coverage",
    "test:unit": "vitest run --config vitest.workspace.mts --project unit",
    "test:unit:coverage": "vitest run --config vitest.workspace.mts --project unit --coverage",
    "test:unit:watch": "vitest --config vitest.workspace.mts --project unit",
    "test:integration": "vitest run --config vitest.workspace.mts --project integration",
    "test:integration:coverage": "vitest run --config vitest.workspace.mts --project integration --coverage",
    "test:integration:watch": "vitest --config vitest.workspace.mts --project integration",
    "test:contract": "vitest run --config vitest.workspace.mts --project unit tests/unit/config/openapi.contract.test.ts",
    "test:chaos": "ts-node -r tsconfig-paths/register scripts/chaos-outbox.ts",
    "smoke:staging": "node scripts/smoke-staging.cjs",
    "outbox:replay": "ts-node -r tsconfig-paths/register scripts/outbox-replay-dead-letters.ts",
    "outbox:cleanup": "ts-node -r tsconfig-paths/register scripts/outbox-cleanup.ts",
    "projection:rebuild:orders": "ts-node -r tsconfig-paths/register scripts/rebuild-order-history-projection.ts",
    "projection:rebuild:products": "ts-node -r tsconfig-paths/register scripts/rebuild-product-catalog-projection.ts",
    "seed": "ts-node scripts/seed.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate && tsc-alias",
    "prisma:reset": "prisma migrate reset --force && ts-node scripts/seed.ts",
    "prepare": "node scripts/prepare-husky.cjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-express": "0.71.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@prisma/client": "^5.22.0",
    "async-retry": "^1.3.3",
    "bcrypt": "6.0.0",
    "bullmq": "^5.1.8",
    "cloudinary": "2.11.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.2.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.5.0",
    "nodemailer": "10.2.1",
    "opossum": "^10.0.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.0.0",
    "sharp": "^0.35.3",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/async-retry": "^1.4.9",
    "@types/bcrypt": "6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "2.3.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/opossum": "^8.1.9",
    "@types/passport": "^1.0.16",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.0",
    "@types/sharp": "^0.31.1",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^8.56.0",
    "fast-check": "^3.22.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.2.4",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "proxy-addr": "2.0.8"
  }
}
