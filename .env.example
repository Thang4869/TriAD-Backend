NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/triad?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-refresh-secret
JWT_PREAUTH_SECRET=replace-with-at-least-32-characters-preauth-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
TOTP_ISSUER=TriAD
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

FRONTEND_URL=http://localhost:3000

# Optional cookie domain.
# Leave unset when frontend/backend use unrelated domains
# such as *.vercel.app and *.onrender.com.
# COOKIE_DOMAIN=

CORS_ORIGIN=http://localhost:3000

# Proxy trust: 0 = do not trust X-Forwarded-For. Set only when behind a
# known reverse proxy (e.g. 1 for a single controlled proxy hop).
# For multiple proxies, prefer explicit IPv4 CIDRs / trusted IPs.
# Do not configure true, 0.0.0.0/0, IPv6 CIDRs or IPv4-mapped IPv6 CIDRs.
TRUST_PROXY=0

# Required when NODE_ENV=production (including deployed staging).
# Use real provider values in the hosting dashboard; keep these commented locally.
# SMTP_HOST=
# SMTP_PORT=587
# Render Free blocks SMTP ports 25/465/587; verify provider support for an
# allowed port (e.g. 2525), or review a paid web-service plan before email tests.
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional OAuth providers. Configure Google first, then Facebook.
# Leave each provider absent until its app and callback flow are ready.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_CALLBACK_URL=

# Optional tracing; configure an actual collector before enabling.
ENABLE_TRACING=false
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Read-only smoke check: npm run smoke:staging
# STAGING_BASE_URL=https://your-staging-api-origin
# STAGING_SMOKE_TIMEOUT_MS=10000
