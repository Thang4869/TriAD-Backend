{
  "name": "triad-backend",
  "version": "1.0.0",
  "description": "TriAD E-Commerce Backend API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "dev": "cross-env TS_NODE_BASEURL=./ kill-port 5000 && cross-env TS_NODE_BASEURL=./ nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "typecheck": "tsc --noEmit",
    "vitest:test": "vitest --run --no-file-parallelism",
    "vitest:test watch": "vitest --no-file-parallelism",
    "test:coverage": "vitest run --coverage",
    "vitest:test coverage": "vitest --coverage --no-file-parallelism",
    "seed": "ts-node scripts/seed.ts",
    "run seed": "run-seed",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:generate types": "prisma generate && tsc-alias",
    "prisma:reset db": "prisma migrate reset --force && ts-node scripts/seed.ts",
    "prisma:generate db": "prisma generate",
    "kill-port": "kill-port 5000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts",
    "prepare": "husky install"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/nodemailer": "^8.0.1",
    "@types/speakeasy": "^2.0.10",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/auto-instrumentations-node": "^0.50.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@opentelemetry/instrumentation-express": "^0.39.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^2.3.0",
    "bullmq": "^5.1.8",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.2.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.3.4",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "prisma": "^5.22.0",
    "rate-limit-redis": "^4.0.0",
    "sharp": "^0.35.3",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "zod": "^3.22.4",
    "prom-client": "^15.1.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/helmet": "^0.0.48",
    "@types/multer": "^1.4.13",
    "@types/node": "^26.2.0",
    "@types/passport": "^1.0.16",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.0",
    "@types/sharp": "^0.31.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11",
    "cloudinary": "^1.41.0"
  },
  "_moduleAliases": {
    "@core": "./dist/core",
    "@modules": "./dist/modules",
    "@shared": "./dist/shared",
    "@config": "./dist/config"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
